# Server Port
PORT=3000

# PostgreSQL Connection String (Contabo VPS, Supabase, Neon, Railway, or local)
# Format: postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/zirapay

# JWT Secret for signing auth tokens (mandatory)
JWT_SECRET=your_jwt_secret_key_here

# Public base URL of this deployment (no trailing slash) — used to build
# links that go out in emails, e.g. password-reset links.
# Example: https://app.zirapay.ng
APP_BASE_URL=

# Resend (https://resend.com) — used for OTP verification and
# password-reset emails. Leave RESEND_API_KEY blank to disable email
# sending (endpoints still work, but no mail goes out).
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Telegram Bot Token from @BotFather (optional for offline dev, required for bot & notifications)
TELEGRAM_BOT_TOKEN=

# Paystack / Korapay Secret Key for bank verification (optional or 'mock' for local dev)
PAYSTACK_SECRET_KEY=mock
KORAPAY_SECRET_KEY=mock

# Flutterwave Secret Key — REQUIRED for rider withdrawals/payouts to actually
# go out. Without a live key here, every withdrawal request debits the rider's
# wallet, immediately fails at the payout step, and auto-refunds. Get this
# from your Flutterwave dashboard (live key, not test) before going live.
FLW_SECRET_KEY=

# Flutterwave Webhook secret hash — set the SAME value in your Flutterwave
# dashboard's webhook settings (Settings > Webhooks > Secret Hash) AND here.
# REQUIRED for withdrawals to ever move from "processing" to "completed": the
# webhook at POST /api/driver/webhooks/flutterwave is rejected with 401 and
# silently ignored without this, so payouts Flutterwave actually accepts will
# sit stuck at "processing" forever.
FLW_WEBHOOK_HASH=

# Default Admin Account Seed Credentials
ADMIN_EMAIL=admin@zirapay.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=ZiraPay System Admin
